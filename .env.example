BOT_TOKEN=123456:replace-with-real-token
APP_TIMEZONE=Europe/Moscow
DB_PATH=storage/bot_data.db
MESSAGE_RETENTION_DAYS=30
SUBSCRIPTION_FAILURE_RETENTION_DAYS=90
DIGEST_POST_RETENTION_DAYS=30
MAX_ERROR_TEXT_LENGTH=800

# Большие дайджесты публикуются в Telegraph одной ссылкой при таком числе постов и более.
DIGEST_TELEGRAPH_THRESHOLD=4
# Необязательно: токен Telegraph. Если пуст, бот создаст аккаунт автоматически при первой публикации.
TELEGRAPH_TOKEN=

# DeepSeek (анализ каналов и саммари). Без ключа ИИ-функции отключены, остальное работает.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Лимит ИИ-запросов в сутки на пользователя (0 = без лимита).
AI_DAILY_LIMIT=10

# Лимиты импорта JSON, чтобы один файл не перегрузил бота.
MAX_IMPORT_SUBSCRIPTIONS=300
MAX_IMPORT_BOOKMARKS=1000
MAX_IMPORT_REMINDERS=500
MAX_IMPORT_FILE_BYTES=2097152

# Источник контента каналов: auto использует MTProto при наличии всех секретов,
# иначе безопасно откатывается к Telegram Web.
CHANNEL_SOURCE=auto
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_USER_SESSION=
MTPROTO_WEB_FALLBACK=true
MTPROTO_FETCH_LIMIT=1000
